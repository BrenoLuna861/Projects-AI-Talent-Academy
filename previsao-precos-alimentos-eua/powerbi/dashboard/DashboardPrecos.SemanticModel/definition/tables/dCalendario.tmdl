table dCalendario
	lineageTag: 3355f0b5-221c-4310-bafc-28c16c9369c4
	dataCategory: Time

	column data
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 0bcda80f-8dba-445f-9310-33cd77eff804
		summarizeBy: none
		isNameInferred
		sourceColumn: [data]

		annotation SummarizationSetBy = Automatic

	column ano
		formatString: 0
		lineageTag: 19fa0dfa-c040-499d-9a1c-1e70bd62bfaf
		summarizeBy: none
		isNameInferred
		sourceColumn: [ano]

		annotation SummarizationSetBy = Automatic

	column mes
		formatString: 0
		lineageTag: 4c69dea8-37c6-4266-b9fc-2071808377d3
		summarizeBy: none
		isNameInferred
		sourceColumn: [mes]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source = SELECTCOLUMNS(FILTER(CALENDAR(DATE(2015, 1, 1), DATE(2026, 12, 1)), DAY([Date]) = 1), "data", [Date], "ano", YEAR([Date]), "mes", MONTH([Date]))

