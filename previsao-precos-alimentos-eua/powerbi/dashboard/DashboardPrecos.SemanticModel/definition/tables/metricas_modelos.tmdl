table metricas_modelos
	lineageTag: 17f1c487-7d70-4300-87c8-71b42489c353

	column corte
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: d3f366e8-34f4-4934-9c5c-194f01b3eb1b
		summarizeBy: none
		sourceColumn: corte

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column modelo
		dataType: string
		lineageTag: 78cf39f9-7da6-4164-b48c-d6f75e9f7aa9
		summarizeBy: none
		sourceColumn: modelo

		annotation SummarizationSetBy = Automatic

