		lineageTag: a72bcd96-fd3d-53e4-9c13-7de3b203e411
		summarizeBy: none
		sourceColumn: mape

		annotation SummarizationSetBy = Automatic

	column wape
		dataType: double
		lineageTag: 3a38a4a7-5717-5783-85c1-1fa7898eb4c8
		summarizeBy: none
		sourceColumn: wape

