table metricas_modelos
	lineageTag: 4489df43-f330-5343-b282-f313262cef8c

	column corte
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 35c760f2-42ba-5314-86f8-6babffa3234b
		summarizeBy: none
		sourceColumn: corte

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column modelo
		dataType: string
		lineageTag: 25e5fa8d-c0ad-5384-90d3-df99290f1ae6
		summarizeBy: none
		sourceColumn: modelo

		annotation SummarizationSetBy = Automatic

