		lineageTag: 7ef95247-c594-4d83-9121-3140d2b324d2
		summarizeBy: none
		sourceColumn: mae_usd

		annotation SummarizationSetBy = Automatic

	column mape
		dataType: double
		lineageTag: 89d833ba-8077-4c95-a7ce-36c33a7f465a
		summarizeBy: none
		sourceColumn: mape

		annotation SummarizationSetBy = Automatic

	column wape
		dataType: double
		lineageTag: d1ac47bb-9ba2-4d3d-bd53-96cbf4540815
		summarizeBy: none
		sourceColumn: wape

		annotation SummarizationSetBy = Automatic

	column vies_pct
		dataType: double
		lineageTag: 965c1756-403e-41f1-8510-a8da2fa90142
