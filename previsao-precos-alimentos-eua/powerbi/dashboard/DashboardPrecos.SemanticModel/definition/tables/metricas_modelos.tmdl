		sourceColumn: data_execucao

		annotation SummarizationSetBy = Automatic

	column modelo_nome = SWITCH([modelo], "combinado", "GB + SARIMA", "gradient_boosting", "Gradient boosting", "random_forest", "Random forest", "ridge", "Ridge", "sarima", "SARIMA", "ets", "Holt-Winters", "ingenuo", "Repetir preço atual", "sazonal_ingenuo", "Repetir ano anterior", [modelo])
		dataType: string
		lineageTag: 016e5302-315b-52b4-84e9-f8cb54b2b3b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition metricas_modelos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "metricas_modelos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"corte", type date}, {"modelo", type text}, {"mae_usd", type number}, {"mape", type number}, {"wape", type number}, {"vies_pct", type number}, {"ganho_vs_ingenuo_pct", type number}, {"series_melhor_que_ingenuo_pct", type number}, {"data_execucao", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
