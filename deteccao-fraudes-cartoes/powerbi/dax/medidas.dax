// ======================================================
// Medidas — Dashboard de Detecção de Fraudes
// Tabelas: fTransacoes (transacoes_dashboard.csv)
//          fPredicoes  (predicoes.csv)
//          fMetricas   (metricas_modelo.csv)
// Colar em uma tabela de medidas dedicada (_Medidas)
// ======================================================

// ---------- Volume e valor ----------
Total Transacoes =
COUNTROWS ( fTransacoes )

Valor Total =
SUM ( fTransacoes[valor] )

Ticket Medio =
AVERAGE ( fTransacoes[valor] )

// ---------- Alertas do modelo ----------
Transacoes Suspeitas =
CALCULATE ( COUNTROWS ( fPredicoes ), fPredicoes[classe_prevista] = 1 )

Taxa de Alerta % =
DIVIDE ( [Transacoes Suspeitas], [Total Transacoes], 0 )

Valor em Risco =
CALCULATE ( SUM ( fTransacoes[valor] ), fPredicoes[classe_prevista] = 1 )

Ticket Medio Suspeita =
CALCULATE ( AVERAGE ( fTransacoes[valor] ), fPredicoes[classe_prevista] = 1 )

// ---------- Fraude observada (contestacao) ----------
Fraudes Reais =
CALCULATE ( COUNTROWS ( fPredicoes ), fPredicoes[classe_real] = 1 )

Taxa de Fraude Real % =
DIVIDE ( [Fraudes Reais], [Total Transacoes], 0 )

Valor Contestado =
CALCULATE ( SUM ( fTransacoes[valor] ), fPredicoes[classe_real] = 1 )

// ---------- Padroes investigados na Aula 08 ----------
Transacoes na Madrugada =
CALCULATE ( COUNTROWS ( fTransacoes ), fTransacoes[madrugada] = 1 )

% na Madrugada =
DIVIDE ( [Transacoes na Madrugada], [Total Transacoes], 0 )

Transacoes com Padrao Teste de Cartao =
CALCULATE ( COUNTROWS ( fTransacoes ), fTransacoes[padrao_teste_cartao] = 1 )

Transacoes Online =
CALCULATE ( COUNTROWS ( fTransacoes ), fTransacoes[canal] = "online" )

% Online =
DIVIDE ( [Transacoes Online], [Total Transacoes], 0 )

// ---------- Matriz de confusao ----------
Verdadeiros Positivos =
CALCULATE (
    COUNTROWS ( fPredicoes ),
    fPredicoes[classe_prevista] = 1,
    fPredicoes[classe_real] = 1
)

Falsos Positivos =
CALCULATE (
    COUNTROWS ( fPredicoes ),
    fPredicoes[classe_prevista] = 1,
    fPredicoes[classe_real] = 0
)

Falsos Negativos =
CALCULATE (
    COUNTROWS ( fPredicoes ),
    fPredicoes[classe_prevista] = 0,
    fPredicoes[classe_real] = 1
)

Verdadeiros Negativos =
CALCULATE (
    COUNTROWS ( fPredicoes ),
    fPredicoes[classe_prevista] = 0,
    fPredicoes[classe_real] = 0
)

// ---------- Desempenho do modelo ----------
Recall =
DIVIDE ( [Verdadeiros Positivos], [Verdadeiros Positivos] + [Falsos Negativos], 0 )

Precision =
DIVIDE ( [Verdadeiros Positivos], [Verdadeiros Positivos] + [Falsos Positivos], 0 )

F1 Score =
DIVIDE ( 2 * [Precision] * [Recall], [Precision] + [Recall], 0 )

Fraudes Nao Detectadas (Valor) =
CALCULATE (
    SUM ( fTransacoes[valor] ),
    fPredicoes[classe_prevista] = 0,
    fPredicoes[classe_real] = 1
)

Limiar Utilizado =
CALCULATE ( MAX ( fMetricas[limiar] ) )

// ---------- Evolucao ----------
Taxa de Alerta % MA7 =
AVERAGEX (
    DATESINPERIOD ( dCalendario[data], MAX ( dCalendario[data] ), -7, DAY ),
    [Taxa de Alerta %]
)
